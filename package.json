{
  "name": "qe-leadership-lab",
  "private": true,
  "version": "1.0.0",
  "description": "Runnable quality engineering and release governance portfolio",
  "scripts": {
    "start": "node tools/server.cjs",
    "test": "node --test tests/unit/*.test.cjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:full": "playwright test",
    "quality:gate": "node tools/release-gate.cjs",
    "check": "npm test && npm run test:e2e && npm run quality:gate"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  }
}
